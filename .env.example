# StackSense configuration. Copy to .env (optional) - the engine runs fully without any of these.
# Real environment variables take precedence over values in .env.

# --- Optional LLM description assistant (OFF by default) -----------------------------
# The LLM is NEVER used to choose the stack; it only suggests form values from the free-text
# description in the web UI, which the user must accept. Leave "off" for the LLM-off test.
STACKSENSE_LLM=off
# Needed only when STACKSENSE_LLM=on (also requires: pip install anthropic)
ANTHROPIC_API_KEY=
STACKSENSE_LLM_MODEL=claude-opus-5-5

# --- Web server ----------------------------------------------------------------------
STACKSENSE_HOST=127.0.0.1
STACKSENSE_PORT=8000
# 1 = open the browser automatically when `python stacksense.py serve` starts
STACKSENSE_OPEN_BROWSER=1
# 1 = silence per-request logging
STACKSENSE_QUIET=0
